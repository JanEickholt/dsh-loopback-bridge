{
  "name": "dsh-loopback-bridge",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: auth-gated host-side relay so the right-Sidebar Browser resolves loopback URLs (e.g. localhost:5173) on the DSH host instead of the PC accessing the GUI, renders embedding-restricted public sites, and offers an OpenCode-style element picker.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanEickholt/dsh-loopback-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/JanEickholt/dsh-loopback-bridge/issues"
  },
  "homepage": "https://github.com/JanEickholt/dsh-loopback-bridge#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar-browser",
    "loopback",
    "proxy",
    "relay",
    "element-inspector"
  ],
  "author": "Jan Eickholt",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "host-bundle-patches",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^26.2.0",
    "tsdown": "0.22.2",
    "typescript": "~5.9.2"
  },
  "license": "MIT"
}
